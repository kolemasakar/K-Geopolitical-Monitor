# O1 P5: reproducible *synthetic-only* isolation probe.
# Image digest is intentionally not yet pinned: not production/release attestation.
FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /build
COPY pyproject.toml README.md ./
COPY src ./src
COPY migrations ./migrations
RUN python -m pip install --no-cache-dir -e . && \
    python -m pip check
WORKDIR /tmp
USER 65534:65534
ENTRYPOINT ["python", "-m", "kgeopolitical_monitor.offline_isolation_child"]
