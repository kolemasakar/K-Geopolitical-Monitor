# O1 P5: reproducible *synthetic-only* isolation probe.
# Image digest is intentionally not yet pinned: not production/release attestation.
FROM python:3.11-slim-bookworm@sha256:f06d01d4ba3f8ad5af45a3ec87df19c1d317d8e8961edc0fabda61811af6f7cf
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /build
COPY pyproject.toml README.md ./
COPY src ./src
COPY migrations ./migrations
COPY constraints/ci.txt ./constraints/ci.txt
RUN PIP_CONSTRAINT=/build/constraints/ci.txt python -m pip install --no-cache-dir -e . && \
    python -m pip check
WORKDIR /tmp
USER 65534:65534
ENTRYPOINT ["python", "-m", "kgeopolitical_monitor.offline_isolation_child"]
