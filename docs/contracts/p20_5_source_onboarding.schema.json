{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgm.local/contracts/p20_5_source_onboarding.schema.json",
  "title": "KGM P20.5 Source Onboarding Readiness Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "source_id",
    "display_name",
    "source_type",
    "geography_scope",
    "language_scope",
    "primary_domain_or_endpoint",
    "collection_method",
    "access_mode",
    "cost_mode",
    "authentication_mode",
    "data_classification",
    "resource_authorization_state",
    "expected_freshness_minutes",
    "collection_cadence_minutes",
    "health_behavior_status",
    "fixture_validation_status",
    "rollback_disable_status",
    "governance_review_status",
    "origin_group_id",
    "syndication_or_copy_relation",
    "provenance_completeness",
    "independence_credit_granted",
    "eligibility_decision",
    "live_activation_authorized",
    "live_activation_state"
  ],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "display_name": {"type": "string", "minLength": 1},
    "source_type": {
      "type": "string",
      "enum": [
        "OFFICIAL_GOVERNMENT",
        "INTERNATIONAL_ORGANIZATION",
        "WIRE_SERVICE",
        "NATIONAL_MEDIA",
        "REGIONAL_LOCAL_MEDIA",
        "DEFENSE_SECURITY",
        "THINK_TANK_RESEARCH",
        "PUBLIC_OSINT",
        "ECONOMIC_ENERGY",
        "SANCTIONS_REGULATORY",
        "APPROVED_PUBLIC_SOCIAL",
        "OTHER_EXPLICITLY_CLASSIFIED"
      ]
    },
    "geography_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "language_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "primary_domain_or_endpoint": {"type": "string", "minLength": 1},
    "collection_method": {
      "type": "string",
      "enum": ["RSS", "ATOM", "HTML", "API_PUBLIC", "PUBLIC_SOCIAL", "MANUAL_REFERENCE", "OTHER_PUBLIC"]
    },
    "access_mode": {"type": "string", "enum": ["PUBLIC_ANONYMOUS", "PUBLIC_AUTHENTICATED", "RESTRICTED"]},
    "cost_mode": {"type": "string", "enum": ["FREE", "PAID"]},
    "authentication_mode": {"type": "string", "enum": ["NONE", "API_KEY", "TOKEN", "OTHER_SECRET"]},
    "data_classification": {"type": "string", "enum": ["PUBLIC", "NONPUBLIC"]},
    "resource_authorization_state": {"type": "string", "enum": ["NOT_REQUIRED", "APPROVED", "NOT_APPROVED"]},
    "expected_freshness_minutes": {"type": "integer", "minimum": 1},
    "collection_cadence_minutes": {"type": "integer", "minimum": 1},
    "health_behavior_status": {"type": "string", "enum": ["PASS", "FAIL", "MISSING"]},
    "fixture_validation_status": {"type": "string", "enum": ["PASS", "FAIL", "MISSING"]},
    "rollback_disable_status": {"type": "string", "enum": ["PASS", "FAIL", "MISSING"]},
    "governance_review_status": {"type": "string", "enum": ["APPROVED", "REJECTED", "PENDING"]},
    "origin_group_id": {"type": ["string", "null"], "minLength": 1},
    "syndication_or_copy_relation": {
      "type": ["string", "null"],
      "enum": ["ORIGINAL", "SYNDICATED_COPY", "AGGREGATOR_COPY", "DERIVED", "UNKNOWN", null]
    },
    "provenance_completeness": {"type": "string", "enum": ["KNOWN", "PARTIAL", "UNKNOWN"]},
    "independence_credit_granted": {"const": false},
    "eligibility_decision": {"type": "string", "enum": ["ELIGIBLE_NOT_ACTIVE", "BLOCKED", "REJECTED"]},
    "live_activation_authorized": {"const": false},
    "live_activation_state": {"const": "NOT_ACTIVE"},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
