{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgm.local/contracts/p20_coverage_policy.schema.json",
  "title": "KGM Phase 20 Coverage Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "version", "cells"],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_id",
          "region",
          "country",
          "language",
          "source_types",
          "topic_role",
          "required",
          "minimum_source_count",
          "minimum_independent_origin_count",
          "maximum_stale_share",
          "maximum_dominant_origin_share"
        ],
        "properties": {
          "cell_id": {"type": "string", "minLength": 1},
          "region": {"type": "string", "minLength": 1},
          "country": {"type": ["string", "null"]},
          "language": {"type": "string", "minLength": 2},
          "source_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "OFFICIAL_GOVERNMENT",
                "INTERNATIONAL_ORGANIZATION",
                "WIRE_SERVICE",
                "NATIONAL_MEDIA",
                "REGIONAL_LOCAL_MEDIA",
                "DEFENSE_SECURITY",
                "THINK_TANK_RESEARCH",
                "PUBLIC_OSINT",
                "ECONOMIC_ENERGY",
                "SANCTIONS_REGULATORY",
                "APPROVED_PUBLIC_SOCIAL",
                "OTHER_EXPLICITLY_CLASSIFIED"
              ]
            }
          },
          "topic_role": {"type": ["string", "null"]},
          "required": {"type": "boolean"},
          "minimum_source_count": {"type": "integer", "minimum": 0},
          "minimum_independent_origin_count": {"type": "integer", "minimum": 0},
          "maximum_stale_share": {"type": "number", "minimum": 0, "maximum": 1},
          "maximum_dominant_origin_share": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
