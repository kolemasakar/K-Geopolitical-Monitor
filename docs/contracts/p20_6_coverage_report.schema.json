{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgm.local/contracts/p20_6_coverage_report.schema.json",
  "title": "KGM Phase 20.6 Coverage Evaluation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "input_refs",
    "evaluation_basis",
    "global_summary",
    "cells",
    "report_sections",
    "changes_since_previous_report",
    "epistemic_boundary",
    "safety_boundary"
  ],
  "properties": {
    "schema_version": {"const": "kgm.p20.6.coverage_report.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "input_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_matrix", "independence_baseline", "health_baseline"],
      "properties": {
        "coverage_matrix": {"type": "string", "minLength": 1},
        "independence_baseline": {"type": "string", "minLength": 1},
        "health_baseline": {"type": "string", "minLength": 1},
        "previous_report": {"type": ["string", "null"]}
      }
    },
    "evaluation_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_policy_state", "independence_evidence_state", "health_evidence_state"],
      "properties": {
        "coverage_policy_state": {"enum": ["UNSET", "DECLARED"]},
        "independence_evidence_state": {"enum": ["UNKNOWN", "PARTIAL", "COMPLETE"]},
        "health_evidence_state": {"enum": ["UNMEASURED", "PARTIAL", "CURRENT"]}
      }
    },
    "global_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_cell_count",
        "adequate_count",
        "thin_count",
        "monoculture_risk_count",
        "degraded_collection_count",
        "missing_expected_coverage_count",
        "not_required_count",
        "unknown_count",
        "governed_source_count",
        "measured_source_count",
        "known_origin_source_count"
      ],
      "properties": {
        "observed_cell_count": {"type": "integer", "minimum": 0},
        "adequate_count": {"type": "integer", "minimum": 0},
        "thin_count": {"type": "integer", "minimum": 0},
        "monoculture_risk_count": {"type": "integer", "minimum": 0},
        "degraded_collection_count": {"type": "integer", "minimum": 0},
        "missing_expected_coverage_count": {"type": "integer", "minimum": 0},
        "not_required_count": {"type": "integer", "minimum": 0},
        "unknown_count": {"type": "integer", "minimum": 0},
        "governed_source_count": {"type": "integer", "minimum": 0},
        "measured_source_count": {"type": "integer", "minimum": 0},
        "known_origin_source_count": {"type": "integer", "minimum": 0}
      }
    },
    "cells": {
      "type": "array",
      "items": {"$ref": "#/$defs/coverageCell"}
    },
    "report_sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_gaps",
        "language_gaps",
        "source_type_gaps",
        "monoculture_warnings",
        "stale_or_failed_sources",
        "latency_outliers",
        "missing_expected_sources"
      ],
      "properties": {
        "region_gaps": {"$ref": "#/$defs/section"},
        "language_gaps": {"$ref": "#/$defs/section"},
        "source_type_gaps": {"$ref": "#/$defs/section"},
        "monoculture_warnings": {"$ref": "#/$defs/section"},
        "stale_or_failed_sources": {"$ref": "#/$defs/section"},
        "latency_outliers": {"$ref": "#/$defs/section"},
        "missing_expected_sources": {"$ref": "#/$defs/section"}
      }
    },
    "changes_since_previous_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "changes"],
      "properties": {
        "state": {"enum": ["NO_PREVIOUS_REPORT", "COMPARABLE", "NOT_COMPARABLE"]},
        "changes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "epistemic_boundary": {"type": "string", "minLength": 1},
    "safety_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_deployment", "live_source_expansion", "paid_or_shared_resources_authorized", "migration_033"],
      "properties": {
        "runtime_deployment": {"const": false},
        "live_source_expansion": {"const": false},
        "paid_or_shared_resources_authorized": {"const": false},
        "migration_033": {"const": "NOT_CREATED / NOT_PREAUTHORIZED"}
      }
    }
  },
  "$defs": {
    "coverageCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "geography_scope",
        "language",
        "source_type",
        "governed_source_count",
        "independent_origin_count",
        "healthy_source_count",
        "stale_or_failed_source_count",
        "status",
        "reason_codes"
      ],
      "properties": {
        "cell_id": {"type": "string", "minLength": 1},
        "geography_scope": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "source_type": {"type": "string", "minLength": 1},
        "governed_source_count": {"type": "integer", "minimum": 0},
        "independent_origin_count": {"type": ["integer", "null"], "minimum": 0},
        "healthy_source_count": {"type": ["integer", "null"], "minimum": 0},
        "stale_or_failed_source_count": {"type": ["integer", "null"], "minimum": 0},
        "status": {
          "enum": [
            "ADEQUATE",
            "THIN",
            "MONOCULTURE_RISK",
            "DEGRADED_COLLECTION",
            "MISSING_EXPECTED_COVERAGE",
            "NOT_REQUIRED_BY_POLICY",
            "UNKNOWN"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "items", "reason_codes"],
      "properties": {
        "state": {"enum": ["CONFIRMED", "NONE_CONFIRMED", "UNKNOWN"]},
        "items": {"type": "array"},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
