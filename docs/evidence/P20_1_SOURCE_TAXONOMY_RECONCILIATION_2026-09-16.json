    },
    {
      "source_id": "meduza-ru",
      "source_type": "NATIONAL_MEDIA",
      "basis": "national-focus Russian-language news publisher"
    },
    {
      "source_id": "osce-latest-news",
      "source_type": "INTERNATIONAL_ORGANIZATION",
      "basis": "official OSCE institutional source"
    },
    {
      "source_id": "rmf24-pl",
      "source_type": "NATIONAL_MEDIA",
      "basis": "national Polish news publisher"
    },
    {
      "source_id": "uk-government-news-communications",
      "source_type": "OFFICIAL_GOVERNMENT",
      "basis": "official UK government source"
    },
    {
