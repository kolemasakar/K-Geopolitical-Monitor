    "gdelt-doc-json": "PUBLIC_API",
    "haberturk-tr-rss": "RSS",
    "meduza-ru-rss": "RSS",
    "osce-latest-rss-atom": "RSS_ATOM",
    "rmf24-pl-rss": "RSS",
    "govuk-news-atom": "ATOM",
    "ukrainska-pravda-uk-rss": "RSS"
  },
  "historical_reconciliation": [
    {
      "source_id": "haberturk-tr",
      "canonical_current_endpoint": "www.haberturk.com",
      "historical_endpoint_aliases": ["rss.haberturk.com"],
      "rule": "PRESERVE_HISTORICAL_MEASUREMENT_AS_ALIAS_DO_NOT_REWRITE_P12_5"
    }
  ],
  "safety_boundary": {
    "live_source_expansion": false,
    "live_ingest_change": false,
    "runtime_deployment": false,
    "service_restart": false,
    "migration_033": "NOT_CREATED / NOT_PREAUTHORIZED",
    "paid_or_shared_resources_authorized": false
  }
}
