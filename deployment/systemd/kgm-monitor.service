[Unit]
Description=K-Geopolitical Monitor unattended monitoring
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=kgm
Group=kgm
WorkingDirectory=/opt/k-geopolitical-monitor
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/k-geopolitical-monitor/.venv/bin/python -m kgeopolitical_monitor.unattended_runner --project-root /opt/k-geopolitical-monitor --poll-seconds 60
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/k-geopolitical-monitor/data

[Install]
WantedBy=multi-user.target
